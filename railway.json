{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "npm ci --prefix server",
    "watchPatterns": [
      "server/**",
      "core.js",
      "railway.json"
    ]
  },
  "deploy": {
    "startCommand": "node server/main.mjs",
    "healthcheckPath": "/health",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
